{
  "schemaVersion": 1,
  "id": "loadingprotection",
  "version": "${version}",
  "name": "Loading Protection",
  "description": "Protects players from damage and mob targeting while loading into a world or server.",
  "authors": ["LoadingProtection Team"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["com.loadingprotection.LoadingProtectionMod"],
    "client": ["com.loadingprotection.client.LoadingProtectionClient"]
  },
  "mixins": [
    "loadingprotection.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.0",
    "fabric": "*",
    "minecraft": "${minecraft_version}"
  }
}
